<!DOCTYPE html>
<html lang="zh-CN"><head>
<%- include('partials/head', { pageTitle: '意见反馈' }) %>
</head><body>
<%- include('partials/nav', { current: 'feedback', adminName: adminName }) %>
<div class="wrap">
  <h1 class="page-title">意见反馈</h1>
  <div class="page-sub">用户在小程序「意见反馈」页提交的内容，按时间倒序保留最近 300 条。</div>

  <% if (flash.success) { %><div class="alert alert-ok">✅ <%= flash.success %></div><% } %>
  <% if (flash.error) { %><div class="alert alert-error">⚠️ <%= flash.error %></div><% } %>

  <div class="card">
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th>编号</th><th>用户</th><th>类型</th><th>内容</th><th>时间</th><th style="text-align:right">操作</th></tr>
        </thead>
        <tbody>
          <% if (!rows.length) { %>
            <tr><td colspan="6" class="empty-row">暂无反馈</td></tr>
          <% } else { rows.forEach(function (r) { %>
            <tr>
              <td><%= r.id %></td>
              <td><%= r.username || '未知用户' %></td>
              <td><%= r.type || '其他' %></td>
              <td style="max-width:520px;white-space:pre-wrap;line-height:1.7"><%= r.content %></td>
              <td class="nowrap" style="color:#94a3b8;font-size:12.5px"><%= r.create_time %></td>
              <td style="text-align:right">
                <form method="post" action="/admin/feedback/<%= r.id %>/delete" style="display:inline"
                      onsubmit="return confirm('删除这条反馈？')">
                  <button class="btn btn-danger btn-sm" type="submit">删除</button>
                </form>
              </td>
            </tr>
          <% }) } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
</body></html>
