page{--c-primary: #0F766E;--c-primary-dark: #115E59;--c-primary-deep: #134E4A;--c-primary-soft: #CCFBF1;--c-primary-mist: #F0FDFA;--c-accent: #F59E0B;--c-accent-soft: #FEF3C7;--c-danger: #B91C1C;--c-danger-soft: #FEE2E2;--c-info: #3B82F6;--c-info-soft: #DBEAFE;--t-strong: #0F172A;--t-main: #1E293B;--t-sub: #64748B;--t-faint: #94A3B8;--t-invert: #FFFFFF;--bg-page: #F5F7FA;--bg-card: #FFFFFF;--bg-soft: #F8FAFC;--line: #E2E8F0;--r-sm: 8rpx;--r-md: 12rpx;--r-lg: 16rpx;--r-xl: 24rpx;--sh-card: 0 2rpx 10rpx rgba(15, 23, 42, .04);--sh-float: 0 8rpx 24rpx rgba(15, 118, 110, .16);--sh-nav: 0 -6rpx 30rpx rgba(15, 23, 42, .08)}page,view{margin:0;padding:0;box-sizing:border-box}page{background-color:var(--bg-page);color:var(--t-main);font-family:PingFang SC,-apple-system,BlinkMacSystemFont,Microsoft YaHei,sans-serif;-webkit-font-smoothing:antialiased}.page-wrap{min-height:100vh;padding-bottom:160rpx}.card{background:var(--bg-card);border-radius:var(--r-lg);border:1rpx solid var(--line);box-shadow:var(--sh-card)}.sec-head{display:flex;align-items:baseline;justify-content:space-between;padding:0 32rpx;margin-bottom:32rpx}.sec-title{font-size:36rpx;font-weight:700;color:var(--t-strong);letter-spacing:1rpx}.sec-sub{font-size:24rpx;color:var(--t-faint)}.nav-back{width:64rpx;height:64rpx;border-radius:50%;background:rgba(255,255,255,.9);box-shadow:0 2rpx 12rpx rgba(15,23,42,.08);display:flex;align-items:center;justify-content:center;font-size:32rpx;color:var(--t-main);line-height:1}.nav-back:active{transform:scale(.94)}.chip{display:inline-flex;align-items:center;padding:6rpx 18rpx;border-radius:999rpx;font-size:22rpx;font-weight:600;line-height:1.4}.chip-green{background:var(--c-primary-soft);color:var(--c-primary-deep)}.chip-amber{background:var(--c-accent-soft);color:#b45309}.chip-red{background:var(--c-danger-soft);color:#b91c1c}.chip-blue{background:var(--c-info-soft);color:#1d4ed8}.chip-grey{background:#f1f5f9;color:var(--t-sub)}.btn-main{height:92rpx;border-radius:var(--r-md);background:linear-gradient(135deg,#34D399,var(--c-primary-dark));color:#fff;font-size:30rpx;font-weight:600;display:flex;align-items:center;justify-content:center;border:none;box-shadow:var(--sh-float)}.btn-main:active{opacity:.92;transform:translateY(1rpx)}.empty-box{display:flex;flex-direction:column;align-items:center;padding:120rpx 40rpx}.empty-emoji{font-size:96rpx;margin-bottom:24rpx;opacity:.55}.empty-text{font-size:28rpx;color:var(--t-faint);margin-bottom:8rpx}.empty-hint{font-size:24rpx;color:#cbd5e1}@media screen and (min-width: 750px){page{background:#e6efea}.page-wrap,.chat-page{max-width:750px;margin:0 auto;min-height:100vh;background:var(--bg-page);box-shadow:0 0 80rpx rgba(15,23,42,.08)}}
page{--status-bar-height:25px;--top-window-height:0px;--window-top:0px;--window-bottom:0px;--window-left:0px;--window-right:0px;--window-magin:0px}[data-c-h="true"]{display: none !important;}