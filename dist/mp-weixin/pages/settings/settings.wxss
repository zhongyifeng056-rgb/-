.group-title{font-size:24rpx;color:#94a3b8;font-weight:600;padding:28rpx 40rpx 12rpx;letter-spacing:1rpx}.pwd-form{margin:0 32rpx 8rpx;padding:28rpx 30rpx;background:#fff;border-radius:var(--r-lg);box-shadow:var(--sh-card)}.pwd-input{height:88rpx;background:#f8fafc;border:2rpx solid #EEF2F6;border-radius:16rpx;padding:0 22rpx;font-size:27rpx;margin-bottom:16rpx}.pwd-actions{display:flex;justify-content:flex-end;gap:16rpx;margin-top:8rpx}.pwd-btn{padding:16rpx 38rpx;border-radius:16rpx;font-size:26rpx;font-weight:600}.pwd-btn.cancel{background:#f1f5f9;color:#64748b}.pwd-btn.ok{background:linear-gradient(135deg,#14b8a6,#0f766e);color:#fff}.pwd-tip{display:block;margin-top:16rpx;font-size:21rpx;color:#94a3b8;line-height:1.6}scoped>.container{background-color:#f8fafc;min-height:100%}.navbar{display:flex;align-items:center;height:128rpx;padding:0 48rpx;background-color:#fff;box-shadow:0 2px 16rpx rgba(0,0,0,.05);position:-webkit-sticky;position:sticky;top:0;z-index:100}.navbar-left{display:flex;align-items:center;cursor:pointer}.back-icon{font-size:44rpx;margin-right:24rpx;color:#333}.navbar-title{font-size:36rpx;font-weight:600;color:#334155}.setting-list{padding:48rpx}.setting-item{display:flex;align-items:center;justify-content:space-between;padding:32rpx;background-color:#fff;border-radius:24rpx;margin-bottom:24rpx;transition:background-color .2s}.setting-item:active{background-color:#f5f5f5}.setting-label{font-size:32rpx;color:#334155}.setting-value{font-size:28rpx;color:#666}.setting-arrow{font-size:40rpx;color:#ccc}.picker-text{font-size:28rpx;color:#666;padding:16rpx 24rpx;background-color:#f8fafc;border-radius:16rpx}.navbar{display:flex!important;align-items:center!important;justify-content:space-between!important;padding:24rpx 32rpx!important;background:transparent!important;box-shadow:none!important;position:static!important}.navbar-title{font-size:34rpx!important;font-weight:700!important;color:var(--t-strong)!important;flex:1;text-align:center}.navbar-left{display:flex;align-items:center}.navbar-right{min-width:120rpx;display:flex;justify-content:flex-end;align-items:center}.card{border-radius:var(--r-lg)!important;background:#fff!important;box-shadow:var(--sh-card)!important;border:none!important}.tag{border-radius:999rpx!important;padding:5rpx 16rpx!important;font-size:21rpx!important;font-weight:600!important}
