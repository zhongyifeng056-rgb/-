.auth-page{min-height:100%;background:linear-gradient(180deg,#f0fdfa,#f5f7fa 42%,#fff);display:flex;flex-direction:column;align-items:center;padding:0 48rpx;position:relative;overflow:hidden}.bg-blob{position:absolute;border-radius:50%}.b1{width:460rpx;height:460rpx;top:-180rpx;right:-160rpx;background:radial-gradient(circle,rgba(15,118,110,.22),transparent 70%)}.b2{width:320rpx;height:320rpx;top:260rpx;left:-140rpx;background:radial-gradient(circle,rgba(20,184,166,.16),transparent 70%)}.b3{width:400rpx;height:400rpx;bottom:-160rpx;right:-120rpx;background:radial-gradient(circle,rgba(15,118,110,.12),transparent 70%)}.brand{position:relative;z-index:2;display:flex;flex-direction:column;align-items:center;margin-top:130rpx}.brand-logo{width:150rpx;height:150rpx;border-radius:46rpx;background:linear-gradient(135deg,#14b8a6,#0f766e);display:flex;align-items:center;justify-content:center;box-shadow:0 18rpx 44rpx rgba(15,118,110,.32)}.brand-img{width:100%;height:100%;display:block;border-radius:46rpx}.brand-title{font-size:54rpx;font-weight:800;color:#064e3b;letter-spacing:6rpx;margin-top:32rpx}.brand-sub{font-size:25rpx;color:#0f766e;letter-spacing:2rpx;margin-top:12rpx}.brand-feats{display:flex;align-items:center;margin-top:34rpx}.feat{display:flex;align-items:center}.feat-img{width:28rpx;height:28rpx;margin-right:8rpx;flex-shrink:0}.feat-text{font-size:23rpx;color:#64748b}.feat-dot{width:8rpx;height:8rpx;border-radius:50%;background:#99f6e4;margin:0 22rpx}.auth-card{position:relative;z-index:2;width:100%;margin-top:56rpx;background:#fff;border-radius:44rpx;padding:52rpx 44rpx 44rpx;box-shadow:0 20rpx 60rpx rgba(15,23,42,.09)}.card-title{display:block;font-size:42rpx;font-weight:800;color:#0f172a}.card-sub{display:block;font-size:24rpx;color:#94a3b8;margin-top:10rpx}.field{display:flex;align-items:center;height:104rpx;margin-top:28rpx;background:#f8fafc;border:2rpx solid #EEF2F6;border-radius:26rpx;padding:0 28rpx}.field:focus-within{border-color:#5eead4;background:#fff}.field-icon{width:34rpx;height:34rpx;margin-right:18rpx;flex-shrink:0}.field-input{flex:1;height:104rpx;font-size:29rpx;color:#1e293b}.ph{color:#b6c2cf}.field-hint{display:block;font-size:21rpx;color:#94a3b8;margin-top:10rpx;padding-left:8rpx}.auth-btn{height:104rpx;margin-top:44rpx;border-radius:26rpx;background:linear-gradient(135deg,#14b8a6,#0f766e);display:flex;align-items:center;justify-content:center;box-shadow:0 14rpx 34rpx rgba(15,118,110,.3)}.auth-btn:active{transform:translateY(2rpx);opacity:.94}.auth-btn.disabled{opacity:.6}.auth-btn-text{color:#fff;font-size:32rpx;font-weight:700;letter-spacing:8rpx}.spinner{width:32rpx;height:32rpx;border-radius:50%;border:4rpx solid rgba(255,255,255,.4);border-top-color:#fff;animation:authspin .8s linear infinite;margin-right:16rpx}@keyframes authspin{to{transform:rotate(360deg)}}.card-foot{display:flex;align-items:center;justify-content:center;margin-top:34rpx}.foot-text{font-size:25rpx;color:#94a3b8}.foot-link{font-size:25rpx;color:#0f766e;font-weight:700;margin-left:8rpx}.strength{display:flex;align-items:center;gap:10rpx;margin-top:20rpx}.strength-bar{flex:1;height:10rpx;border-radius:6rpx;background:#e9eef3;transition:background .25s}.strength-bar.on-1{background:#f87171}.strength-bar.on-2{background:#fbbf24}.strength-bar.on-3{background:#14b8a6}.strength-text{font-size:21rpx;color:#94a3b8;min-width:100rpx;text-align:right}.agree-row{display:flex;align-items:flex-start;margin-top:28rpx}.agree-box{width:36rpx;height:36rpx;border-radius:10rpx;border:3rpx solid #CBD5E1;flex-shrink:0;margin-right:16rpx;display:flex;align-items:center;justify-content:center;font-size:22rpx;color:#fff}.agree-box.checked{background:#0f766e;border-color:#0f766e}.agree-text{flex:1;font-size:22rpx;color:#94a3b8;line-height:1.6}.agree-link{color:#0f766e;font-weight:600}.copyright{position:relative;z-index:2;margin-top:auto;margin-bottom:50rpx;font-size:21rpx;color:#b6c2cf;letter-spacing:1rpx}.agree-note{display:block;width:100%;margin-top:24rpx;text-align:center;font-size:22rpx;line-height:1.7;color:#94a3b8}.agree-note .agree-link{color:#0f766e}
